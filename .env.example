XT_API_KEY=your_xt_api_key_here
XT_API_SECRET=your_xt_api_secret_here
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL is OPTIONAL. Leave it blank and the bot auto-detects a chat model
# from the provider's /models endpoint (OpenAI, Groq, DeepSeek, OpenRouter, ...).
# On providers with free-tier models (OpenRouter ":free" suffix) it ALWAYS
# prefers a free model when one is available, so you use a zero-cost, usable
# model without setting anything. Set AI_MODEL explicitly to force a model.
AI_MODEL=
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
DATABASE_URL=sqlite:///data/memory.db
